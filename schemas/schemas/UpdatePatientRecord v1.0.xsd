<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="ClientIntegrationRequest">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="APIKey" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="DeviceID" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="DeviceVersion" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="RequestUID" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="Function" fixed="UpdatePatientRecord" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="FunctionVersion" fixed="1" minOccurs="1" maxOccurs="1" type="xs:decimal"/>
            <xs:element name="FunctionParameters" minOccurs="1" maxOccurs="1">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Identity" minOccurs="1" maxOccurs="1">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="NHSNumber" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="PseudoNumber" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="ClientID" maxOccurs="1" type="xs:string"/>
                                    <!--Either NHSNumber, PseudoNumber or ClientID is required, but only one-->
                                    <xs:element name="StrategicReportingIdentifier" maxOccurs="1" type="xs:string"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="Demographics" maxOccurs="1">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="Title" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="FirstName" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="MiddleNames" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="Surname" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="KnownAs" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="DateOfBirth" maxOccurs="1" type="xs:date"/>
                                    <xs:element name="Sex" maxOccurs="1">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="M"/>
                                                <xs:enumeration value="F"/>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:element>
                                    <xs:element name="MaritalStatus" maxOccurs="1">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="Code" minOccurs="1" maxOccurs="1">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                        </xs:sequence>
                                                        <xs:attribute name="Scheme" use="required">
                                                            <xs:simpleType>
                                                                <xs:restriction base="xs:string">
                                                                    <xs:enumeration value="CTV3"/>
                                                                    <xs:enumeration value="Snomed"/>
                                                                </xs:restriction>
                                                            </xs:simpleType>
                                                        </xs:attribute>
                                                        <xs:attribute name="Code" use="required" type="xs:string"/>
                                                        <xs:attribute name="Term" type="xs:string"/>
                                                    </xs:complexType>
                                                </xs:element>
                                            </xs:sequence>
                                        </xs:complexType>
                                    </xs:element>
                                    <xs:element name="Ethnicity" maxOccurs="1">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="Code" minOccurs="1" maxOccurs="1">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                        </xs:sequence>
                                                        <xs:attribute name="Scheme" use="required">
                                                            <xs:simpleType>
                                                                <xs:restriction base="xs:string">
                                                                    <xs:enumeration value="CTV3"/>
                                                                    <xs:enumeration value="Snomed"/>
                                                                </xs:restriction>
                                                            </xs:simpleType>
                                                        </xs:attribute>
                                                        <xs:attribute name="Code" use="required" type="xs:string"/>
                                                        <xs:attribute name="Term" type="xs:string"/>
                                                    </xs:complexType>
                                                </xs:element>
                                            </xs:sequence>
                                        </xs:complexType>
                                    </xs:element>
                                    <xs:element name="MainLanguage" maxOccurs="1">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="Code" minOccurs="1" maxOccurs="1">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                        </xs:sequence>
                                                        <xs:attribute name="Scheme" use="required">
                                                            <xs:simpleType>
                                                                <xs:restriction base="xs:string">
                                                                    <xs:enumeration value="CTV3"/>
                                                                    <xs:enumeration value="Snomed"/>
                                                                </xs:restriction>
                                                            </xs:simpleType>
                                                        </xs:attribute>
                                                        <xs:attribute name="Code" use="required" type="xs:string"/>
                                                        <xs:attribute name="Term" type="xs:string"/>
                                                    </xs:complexType>
                                                </xs:element>
                                            </xs:sequence>
                                        </xs:complexType>
                                    </xs:element>
                                    <xs:element name="EnglishSpeaker" maxOccurs="1">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="Unknown"/>
                                                <xs:enumeration value="Yes"/>
                                                <xs:enumeration value="No"/>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:element>
                                    <xs:element name="HomeTelephone" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="WorkTelephone" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="MobileTelephone" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="AlternateTelephone" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="EmailAddress" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="SMSConsent" maxOccurs="1">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="Yes"/>
                                                <xs:enumeration value="No"/>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:element>
                                    <xs:element name="UsualGPUserName" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="CareStartDate" maxOccurs="1" type="xs:date"/>
                                    <xs:element name="RegistrationType" maxOccurs="1" type="xs:string"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="Clinical" maxOccurs="1">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="Event">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="Medication">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="MedicationType" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="Other medication"/>
                                                                        <xs:enumeration value="NHS medication"/>
                                                                        <xs:enumeration value="Private issue"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <xs:element name="Drug" minOccurs="1" maxOccurs="1">
                                                                <xs:complexType>
                                                                    <xs:sequence>
                                                                    </xs:sequence>
                                                                    <xs:attribute name="Scheme" use="required">
                                                                        <xs:simpleType>
                                                                            <xs:restriction base="xs:string">
                                                                                <xs:enumeration value="Multilex"/>
                                                                                <xs:enumeration value="Dmd"/>
                                                                            </xs:restriction>
                                                                        </xs:simpleType>
                                                                    </xs:attribute>
                                                                    <xs:attribute name="ProductID" use="required" type="xs:string"/>
                                                                    <xs:attribute name="PackID" type="xs:integer"/>
                                                                    <!--PackID is only used when the Scheme is Multilex-->
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="Dose" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                            <xs:element name="Quantity" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                            <xs:element name="StartDate" minOccurs="1" maxOccurs="1" type="xs:date"/>
                                                            <xs:element name="EndDate" minOccurs="1" maxOccurs="1" type="xs:date"/>
                                                            <xs:element name="RepeatIssue" minOccurs="0" maxOccurs="1">
                                                                <xs:complexType>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="LinkedProblemUID" type="xs:string"/>
                                                        </xs:sequence>
                                                    </xs:complexType>
                                                </xs:element>
                                                <xs:element name="ClinicalCode">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="Code" minOccurs="1" maxOccurs="1">
                                                                <xs:complexType>
                                                                    <xs:sequence>
                                                                    </xs:sequence>
                                                                    <xs:attribute name="Scheme" use="required">
                                                                        <xs:simpleType>
                                                                            <xs:restriction base="xs:string">
                                                                                <xs:enumeration value="CTV3"/>
                                                                                <xs:enumeration value="Snomed"/>
                                                                            </xs:restriction>
                                                                        </xs:simpleType>
                                                                    </xs:attribute>
                                                                    <xs:attribute name="Code" use="required" type="xs:string"/>
                                                                    <xs:attribute name="Term" type="xs:string"/>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="Episodicity" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="New"/>
                                                                        <xs:enumeration value="Ongoing"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <xs:element name="Value" maxOccurs="1" type="xs:decimal"/>
                                                            <xs:element name="Units" maxOccurs="1" type="xs:string"/>
                                                            <!--If units aren't specified, the default SystmOne units for that code will be used-->
                                                            <xs:element name="Comparator" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:integer">
                                                                        <xs:enumeration value="4"/>
                                                                        <xs:enumeration value="3"/>
                                                                        <xs:enumeration value="6"/>
                                                                        <xs:enumeration value="5"/>
                                                                        <xs:enumeration value="7"/>
                                                                        <xs:enumeration value="8"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <!--If the comparator is not specified, equals (4) will be assumed. The comparators are as follows:-->
                                                            <!--Approximate (3); Equal (4); Greater than or Equal (5); Greater Than (6); Less Than (7); Less than or Equal (8)-->
                                                            <xs:element name="ProblemSeverity" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="Major"/>
                                                                        <xs:enumeration value="Minor"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <!--Specify the problem severity to turn this new code into a Problem Header-->
                                                            <xs:element name="ProblemEndDate" maxOccurs="1" type="xs:date"/>
                                                            <!--The problem end date is only used if a problem severity is also specified-->
                                                            <xs:element name="FreeText" maxOccurs="1" type="xs:string"/>
                                                            <xs:element name="LinkedProblemUID" type="xs:string"/>
                                                        </xs:sequence>
                                                    </xs:complexType>
                                                </xs:element>
                                                <xs:element name="Reminder">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="FreeText" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                            <xs:element name="Severity" minOccurs="1" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="Low"/>
                                                                        <xs:enumeration value="Normal"/>
                                                                        <xs:enumeration value="High"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <xs:element name="ExpiryDate" maxOccurs="1" type="xs:date"/>
                                                            <!--If an expiry date is not provided, the reminder will remain until manually removed-->
                                                            <xs:element name="LinkedProblemUID" type="xs:string"/>
                                                        </xs:sequence>
                                                    </xs:complexType>
                                                </xs:element>
                                                <xs:element name="Recall">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="RecallDate" minOccurs="1" maxOccurs="1" type="xs:date"/>
                                                            <xs:element name="Type" minOccurs="1" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="CHS 1 Year Exam Doctor"/>
                                                                        <xs:enumeration value="CHS 1 Year Exam Health Visitor"/>
                                                                        <xs:enumeration value="CHS 1 Year Exam Health Visitor At Home"/>
                                                                        <xs:enumeration value="CHS 2-2.5 Year Exam Doctor"/>
                                                                        <xs:enumeration value="CHS 2-2.5 Year Exam Health Visitor"/>
                                                                        <xs:enumeration value="CHS 2-2.5 Year Exam Health Visitor At Home"/>
                                                                        <xs:enumeration value="Cytology Smear 47y+"/>
                                                                        <xs:enumeration value="decapeptyl SR 3m"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <!--Permitted recall types are defined at the practice level so may not match this enumeration-->
                                                            <xs:element name="FreeText" maxOccurs="1" type="xs:string"/>
                                                            <xs:element name="Status" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="Awaiting Result"/>
                                                                        <xs:enumeration value="Pending"/>
                                                                        <xs:enumeration value="1st Recall"/>
                                                                        <xs:enumeration value="2nd Recall"/>
                                                                        <xs:enumeration value="3rd Recall"/>
                                                                        <xs:enumeration value="Seen"/>
                                                                        <xs:enumeration value="Cancelled by patient"/>
                                                                        <xs:enumeration value="Cancelled by clinician"/>
                                                                        <xs:enumeration value="Suspended"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <!--If no status is provided, the recall with be added as 'Pending'-->
                                                            <xs:element name="LinkedProblemUID" type="xs:string"/>
                                                        </xs:sequence>
                                                    </xs:complexType>
                                                </xs:element>
                                                <xs:element name="Vaccination">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="BatchNumber" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                            <xs:element name="Notes" maxOccurs="1" type="xs:string"/>
                                                            <!--Notes are optional free-text comments on the vaccination-->
                                                            <xs:element name="Name" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                            <!--Several hundred vacc names are supported - check the Available Vaccinations screen in SystmOne for a full list-->
                                                            <xs:element name="PartType" minOccurs="1" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="1"/>
                                                                        <xs:enumeration value="2"/>
                                                                        <xs:enumeration value="3"/>
                                                                        <xs:enumeration value="4"/>
                                                                        <xs:enumeration value="5"/>
                                                                        <xs:enumeration value="6"/>
                                                                        <xs:enumeration value="Single"/>
                                                                        <xs:enumeration value="1st Scheduled Booster"/>
                                                                        <xs:enumeration value="2nd Scheduled Booster"/>
                                                                        <xs:enumeration value="Booster"/>
                                                                        <xs:enumeration value="Unspecified Booster"/>
                                                                        <xs:enumeration value="Adolescent 1"/>
                                                                        <xs:enumeration value="Adolescent 2"/>
                                                                        <xs:enumeration value="Under 1 yr"/>
                                                                        <xs:enumeration value="At Birth"/>
                                                                        <xs:enumeration value="1 Month"/>
                                                                        <xs:enumeration value="2 Months"/>
                                                                        <xs:enumeration value="3 Months"/>
                                                                        <xs:enumeration value="4 Months"/>
                                                                        <xs:enumeration value="5 Months"/>
                                                                        <xs:enumeration value="6 Months"/>
                                                                        <xs:enumeration value="8 Months"/>
                                                                        <xs:enumeration value="8 Months 1 Week"/>
                                                                        <xs:enumeration value="9 Months"/>
                                                                        <xs:enumeration value="12 Months"/>
                                                                        <xs:enumeration value="15 Months"/>
                                                                        <xs:enumeration value="18 Months"/>
                                                                        <xs:enumeration value="24 Months"/>
                                                                        <xs:enumeration value="3 Years"/>
                                                                        <xs:enumeration value="4 Years"/>
                                                                        <xs:enumeration value="4-6 Years"/>
                                                                        <xs:enumeration value="Primary"/>
                                                                        <xs:enumeration value="5 Years"/>
                                                                        <xs:enumeration value="6 Years"/>
                                                                        <xs:enumeration value="13-16 Years"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <xs:element name="Dosage" maxOccurs="1" type="xs:string"/>
                                                            <!--The dose is required for certain vaccination types-->
                                                            <xs:element name="LinkedProblemUID" type="xs:string"/>
                                                        </xs:sequence>
                                                    </xs:complexType>
                                                </xs:element>
                                                <xs:element name="RepeatMedication">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="Drug" minOccurs="1" maxOccurs="1">
                                                                <xs:complexType>
                                                                    <xs:sequence>
                                                                    </xs:sequence>
                                                                    <xs:attribute name="Scheme" use="required">
                                                                        <xs:simpleType>
                                                                            <xs:restriction base="xs:string">
                                                                                <xs:enumeration value="Multilex"/>
                                                                                <xs:enumeration value="Dmd"/>
                                                                            </xs:restriction>
                                                                        </xs:simpleType>
                                                                    </xs:attribute>
                                                                    <xs:attribute name="ProductID" use="required" type="xs:string"/>
                                                                    <xs:attribute name="PackID" type="xs:integer"/>
                                                                    <!--PackID is only used when the Scheme is Multilex-->
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="Dose" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                            <xs:element name="Quantity" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                            <xs:element name="StartDate" maxOccurs="1" type="xs:date"/>
                                                            <!--If omitted, the RepeatMedication will start immediately-->
                                                            <xs:element name="MaxIssues" maxOccurs="1" type="xs:integer"/>
                                                            <xs:element name="ReviewDate" maxOccurs="1" type="xs:date"/>
                                                            <!--MaxIssues or ReviewDate must be included (or both)-->
                                                            <xs:element name="IssueDurationDays" minOccurs="1" maxOccurs="1" type="xs:integer"/>
                                                            <!--IssueDurationDays indicates how long each issue of the RepeatMedication should last the patient-->
                                                            <xs:element name="MedicationType" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="NHS medication"/>
                                                                        <xs:enumeration value="Private issue"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:element>
                                                            <xs:element name="LinkedProblemUID" type="xs:string"/>
                                                        </xs:sequence>
                                                    </xs:complexType>
                                                </xs:element>
                                                <xs:element name="Letter">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="RecipientName" maxOccurs="1">
                                                                <xs:complexType>
                                                                    <xs:sequence>
                                                                        <xs:element name="Title" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="FirstName" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="MiddleNames" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="Surname" maxOccurs="1" type="xs:string"/>
                                                                    </xs:sequence>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="RecipientOrganisation" maxOccurs="1" type="xs:string"/>
                                                            <!--RecipientName or RecipientOrganisation must be provided-->
                                                            <xs:element name="RecipientAddress" maxOccurs="1">
                                                                <xs:complexType>
                                                                    <xs:sequence>
                                                                        <xs:element name="HouseName" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="HouseNumber" maxOccurs="1" type="xs:string"/>
                                                                        <!--Either House name or number is required-->
                                                                        <xs:element name="Road" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="Locality" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="Town" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="County" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="Postcode" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                                    </xs:sequence>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="SenderName" maxOccurs="1">
                                                                <xs:complexType>
                                                                    <xs:sequence>
                                                                        <xs:element name="Title" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="FirstName" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="MiddleNames" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="Surname" maxOccurs="1" type="xs:string"/>
                                                                    </xs:sequence>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="SenderOrganisation" maxOccurs="1" type="xs:string"/>
                                                            <!--SenderName or SenderOrganisation must be provided-->
                                                            <xs:element name="SenderAddress" maxOccurs="1">
                                                                <xs:complexType>
                                                                    <xs:sequence>
                                                                        <xs:element name="HouseName" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="HouseNumber" maxOccurs="1" type="xs:string"/>
                                                                        <!--Either House name or number is required-->
                                                                        <xs:element name="Road" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="Locality" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="Town" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="County" maxOccurs="1" type="xs:string"/>
                                                                        <xs:element name="Postcode" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                                    </xs:sequence>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="DocumentPath" minOccurs="1" maxOccurs="1" type="xs:string"/>
                                                            <!--DocumentPath provides the path of the letter file, that is read in by SystmOne-->
                                                            <xs:element name="Type" minOccurs="1" maxOccurs="1">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="Prescription or Medication details"/>
                                                                        <xs:enumeration value="Post Natal or 6 Week Check"/>
                                                                        <xs:enumeration value="Annotations"/>
                                                                        <xs:enumeration value="List Action Letter"/>
                                                                        <xs:enumeration value="Letter to Patients"/>
                                                                        <xs:enumeration value="Clinic Letter"/>
                                                                        <xs:enumeration value="Foreign Travel - Immunisation Record"/>
                                                                        <xs:enumeration value="Notes Sent to Solicitor"/>
                                                                        <xs:enumeration value="Payment Before Report"/>
                                                                        <xs:enumeration value="Speech and Language Therapy"/>
                                                                        <xs:enumeration value="Urgent Referrals"/>
                                                                        <xs:enumeration value="Child Adolescent &amp; Family Services"/>
                                                                        <xs:enumeration value="Dermatology"/>
                                                                        <xs:enumeration value="Baby Check 6-8 weeks"/>
                                                                        <xs:enumeration value="Incapacity for work report"/>
                                                                        <xs:enumeration value="Psychosocial assessment of deliberate self harm"/>
                                                                        <xs:enumeration value="Proforma for Implanon"/>
                                                                        <xs:enumeration value="Multi-Disciplinary Team Meeting"/>
                                                                        <xs:enumeration value="Summary of assessed needs"/>
                                                                        <xs:enumeration value="CPA Plan"/>
                                                                        <xs:enumeration value="Private Referral"/>
                                                                        <xs:enumeration value="Endoscopy Report"/>
                                                                        <xs:enumeration value="Acute Low Back Pain Service"/>
                                                                        <xs:enumeration value="Podiatry Service"/>
                                                                        <xs:enumeration value="Histology Report"/>
                                                                        <xs:enumeration value="Stop smoking service"/>
                                                                        <xs:enumeration value="GOS18 report"/>
                                                                        <xs:enumeration value="Discharge summary"/>
                                                                        <xs:enumeration value="Spirometry"/>
                                                                        <xs:enumeration value="Urine Result"/>
                                                                        <xs:enumeration value="Rapid Access Chest Final Report"/>
                                                                        <xs:enumeration value="Community Pharmacy Scheme"/>
                                                                        <xs:enumeration value="Outpatient Prescription Sheets"/>
                                                                        <xs:enumeration value="Diabetic Eye Screening Scheme"/>
                                                                        <xs:enumeration value="CT Scan"/>
                                                                        <xs:enumeration value="Angiography Report"/>
                                                                        <xs:enumeration value="Angioplasty Report"/>
                                                                        <xs:enumeration value="Bone Density Report"/>
                                                                        <xs:enumeration value="Sigmoidoscopy Report"/>
