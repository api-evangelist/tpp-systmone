<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="ClientIntegrationRequest">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="APIKey" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="DeviceID" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="DeviceVersion" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="RequestUID" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="Function" fixed="GetDocument" minOccurs="1" maxOccurs="1" type="xs:string"/>
            <xs:element name="FunctionVersion" fixed="1" minOccurs="1" maxOccurs="1" type="xs:decimal"/>
            <xs:element name="FunctionParameters" minOccurs="1" maxOccurs="1">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Identity" minOccurs="1" maxOccurs="1">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="NHSNumber" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="PseudoNumber" maxOccurs="1" type="xs:string"/>
                                    <xs:element name="ClientID" maxOccurs="1" type="xs:string"/>
                                    <!--Either NHSNumber, PseudoNumber or ClientID is required, but only one-->
                                    <xs:element name="StrategicReportingIdentifier" maxOccurs="1" type="xs:string"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="DocumentUID" minOccurs="1" maxOccurs="1" type="xs:string"/>
                        <xs:element name="LeaveRecordOpen" minOccurs="0" maxOccurs="1">
                            <xs:complexType>
                            </xs:complexType>
                        </xs:element>
                        <!--If LeaveRecordOpen is present, the patient record will be left open in the user interface-->
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:element>
</xs:schema>